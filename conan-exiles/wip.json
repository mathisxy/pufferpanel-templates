    "groups": [
        {
            "display": "Server Settings",
            "description": "",
            "variables": [
                "server_name",
                "server_password",
                "admin_password",
                "server_message_of_the_day",
                "max_nudity",
                "pvp_enabled",
                "mod_list_name"
            ],
            "order": 1
        },
        {
            "display": "Runtime Attributes",
            "description": "",
            "variables": [
                "max_players",
                "port",
                "query_port"
            ],
            "order": 2
        }
    ],
    "install": [
        {
            "type": "command",
            "commands": [
                "/usr/games/steamcmd +login anonymous +quit",
                "/usr/games/steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 443030 validate +quit"
            ]
        }
    ],
    "uninstall": null,
    "run": {
        "command": [
            {
                "command": "/pufferpanel/ConanSandbox/Binaries/Linux/ConanSandboxServer-Linux-Shipping ConanSandbox -log -Port=${port} -QueryPort=${query_port} -MaxPlayers=${max_players} -ServerName=\"${server_name}\" -MULTIHOME=0.0.0.0",
                "if": ""
            }
        ],
        "stopCode": 2,
        "pre": [
            {
                "type": "command",
                "commands": [
                    "/usr/games/steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 443030 +quit"
                ]
            },
            {
                "type": "command",
                "commands": [
                    "mkdir -p /pufferpanel/ConanSandbox/Saved/Config/LinuxServer",
                    "touch /pufferpanel/ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini",
                    "touch /pufferpanel/ConanSandbox/Saved/Config/LinuxServer/Engine.ini"
                ]
            },
            {
                "if": "mod_list_name != \"\"",
                "type": "command",
                "commands": [
                    "mkdir ConanSandbox/Mods",
                    "touch ConanSandbox/Mods/${mod_list_name}"
                ]
            },
            {
                "type": "alterfile",
                "file": "ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini",
                "regex": true,
                "replace": "[ServerSettings]\n",
                "search": "\\A\\z"
            },
            {
                "type": "alterfile",
                "file": "ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini",
                "regex": true,
                "replace": "",
                "search": "(?m)^(ServerPassword|ServerMessageOfTheDay|MaxNudity|PVPEnabled|ServerModList)=.*\\r?\\n?"
            },
            {
                "type": "alterfile",
                "file": "ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini",
                "regex": true,
                "replace": "[ServerSettings]\nServerPassword=${server_password}\nServerMessageOfTheDay=${server_message_of_the_day}\nMaxNudity=${max_nudity}\nPVPEnabled=${pvp_enabled}\nServerModList=${mod_list_name}",
                "search": "\\[ServerSettings\\]"
            },
            {
                "type": "alterfile",
                "file": "ConanSandbox/Saved/Config/LinuxServer/Engine.ini",
                "regex": true,
                "replace": "[OnlineSubsystem]",
                "search": "\\A\\z"
            },
            {
                "type": "alterfile",
                "replace": "",
                "search": "(?m)^(AdminPassword|ServerName)=.*\\r?\\n?",
                "file": "ConanSandbox/Saved/Config/LinuxServer/Engine.ini",
                "regex": true
            },
            {
                "type": "alterfile",
                "file": "ConanSandbox/Saved/Config/LinuxServer/Engine.ini",
                "regex": true,
                "replace": "[OnlineSubsystem]\nServerName=${server_name}\nAdminPassword=${admin_password}\n",
                "search": "\\[OnlineSubsystem\\]"
            }
        ],
        "stdin": {
            "type": "stdin"
        },
        "autostart": false,
        "autorecover": false,
        "autorestart": false
    },
    "environment": {

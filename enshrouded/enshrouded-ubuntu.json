{
    "type": "enshrouded",
    "display": "Enshrouded Server",
    "data": {
        "adminPassword": {
            "type": "string",
            "value": "",
            "display": "Admin Group Password",
            "desc": "Kick/ban, inventories, edit world and base.",
            "required": false,
            "userEdit": true
        },
        "enableTextChat": {
            "type": "boolean",
            "value": false,
            "display": "Enable Text Chat",
            "required": false,
            "userEdit": true
        },
        "enableVoiceChat": {
            "type": "boolean",
            "value": false,
            "display": "Enable Voice Chat",
            "required": false,
            "userEdit": true
        },
        "friendPassword": {
            "type": "string",
            "value": "",
            "display": "Friend Group Password",
            "desc": "Inventories, edit world and base.",
            "required": false,
            "userEdit": true
        },
        "gameSettingsPreset": {
            "type": "option",
            "value": "Default",
            "display": "Difficulty Preset",
            "desc": "Custom: edit gameSettings in enshrouded_server.json yourself.",
            "required": true,
            "userEdit": true,
            "options": [
                {
                    "value": "Default",
                    "display": "Default"
                },
                {
                    "value": "Relaxed",
                    "display": "Relaxed"
                },
                {
                    "value": "Hard",
                    "display": "Hard"
                },
                {
                    "value": "Survival",
                    "display": "Survival"
                },
                {
                    "value": "Custom",
                    "display": "Custom"
                }
            ]
        },
        "guestPassword": {
            "type": "string",
            "value": "",
            "display": "Guest Group Password",
            "desc": "Join only, no changes.",
            "required": false,
            "userEdit": true
        },
        "queryPort": {
            "type": "integer",
            "value": 15637,
            "display": "Query Port",
            "desc": "UDP, must be unique per server.",
            "required": true,
            "userEdit": true
        },
        "serverName": {
            "type": "string",
            "value": "",
            "display": "Server Name",
            "desc": "Shown in the server list.",
            "required": true,
            "userEdit": true
        },
        "slotCount": {
            "type": "integer",
            "value": 16,
            "display": "Player Slots",
            "desc": "1-16.",
            "required": true,
            "userEdit": true
        },
        "visitorPassword": {
            "type": "string",
            "value": "",
            "display": "Visitor Group Password",
            "desc": "Join only, no changes.",
            "required": false,
            "userEdit": true
        }
    },
    "groups": [
        {
            "display": "Server",
            "description": "",
            "variables": [
                "serverName",
                "queryPort",
                "slotCount",
                "gameSettingsPreset",
                "enableVoiceChat",
                "enableTextChat"
            ],
            "order": 1
        },
        {
            "display": "Group Passwords",
            "description": "Empty means no password. Once one is empty, all below must be empty too. Set passwords must differ.",
            "variables": [
                "adminPassword",
                "friendPassword",
                "guestPassword",
                "visitorPassword"
            ],
            "order": 2
        },
        {
            "if": "(adminPassword == '' && friendPassword != '') || (friendPassword == '' && guestPassword != '') || (guestPassword == '' && visitorPassword != '')",
            "display": "Invalid Group Passwords",
            "description": "A password is set below an empty one. The server will not start.",
            "variables": [],
            "order": 3
        }
    ],
    "install": [
        {
            "type": "command",
            "commands": [
                "steamcmd +@sSteamCmdForcePlatformType windows +force_install_dir /pufferpanel +login anonymous +app_info_print 2278520 +app_update 2278520 validate +quit"
            ]
        }
    ],
    "uninstall": null,
    "run": {
        "command": "tini -- wine64 enshrouded_server.exe",
        "stopCode": 2,
        "pre": [
            {
                "if": "(adminPassword == '' && friendPassword != '') || (friendPassword == '' && guestPassword != '') || (guestPassword == '' && visitorPassword != '')",
                "type": "command",
                "commands": [
                    "sh -c \"echo 'Invalid group passwords: a password is set below an empty one.'; exit 1\""
                ]
            },
            {
                "type": "command",
                "commands": [
                    "steamcmd +@sSteamCmdForcePlatformType windows +force_install_dir /pufferpanel +login anonymous +app_update 2278520 +quit"
                ]
            },
            {
                "type": "writefile",
                "target": "update_config.jq",
                "text": "# Groups top to bottom. The first group with an empty password is open to everyone,\n# so the groups below it are unreachable and get removed.\ndef groups: [\n  {\"name\": \"Admin\",   \"password\": ($ENV.ENSHROUDED_ADMIN_PASSWORD   // \"\")},\n  {\"name\": \"Friend\",  \"password\": ($ENV.ENSHROUDED_FRIEND_PASSWORD  // \"\")},\n  {\"name\": \"Guest\",   \"password\": ($ENV.ENSHROUDED_GUEST_PASSWORD   // \"\")},\n  {\"name\": \"Visitor\", \"password\": ($ENV.ENSHROUDED_VISITOR_PASSWORD // \"\")}\n];\n\n# Update the password of an existing group (keeping its permissions) or add the group.\ndef upsert($g):\n  if any(.[]; .name == $g.name)\n  then map(if .name == $g.name then .password = $g.password else . end)\n  else . + [$g] end;\n\n(groups | (map(.password == \"\") | index(true)) // length) as $open\n| (groups[$open + 1:] | map(.name)) as $removed\n| .name = ($ENV.ENSHROUDED_SERVER_NAME // \"\")\n| .queryPort = ${queryPort}\n| .slotCount = ${slotCount}\n| .enableVoiceChat = ${enableVoiceChat}\n| .enableTextChat = ${enableTextChat}\n| .gameSettingsPreset = \"${gameSettingsPreset}\"\n| .userGroups = (.userGroups // []\n    | map(select(.name | IN($removed[]) | not))\n    | reduce groups[:$open + 1][] as $g (.; upsert($g)))\n"
            },
            {
                "type": "command",
                "commands": [
                    "sh -c \"cd /pufferpanel && { [ -f enshrouded_server.json ] || echo {} > enshrouded_server.json; } && jq -f update_config.jq enshrouded_server.json > enshrouded_server.json.new && mv enshrouded_server.json.new enshrouded_server.json\""
                ]
            }
        ],
        "environmentVars": {
            "DISPLAY": "",
            "ENSHROUDED_ADMIN_PASSWORD": "${adminPassword}",
            "ENSHROUDED_FRIEND_PASSWORD": "${friendPassword}",
            "ENSHROUDED_GUEST_PASSWORD": "${guestPassword}",
            "ENSHROUDED_SERVER_NAME": "${serverName}",
            "ENSHROUDED_VISITOR_PASSWORD": "${visitorPassword}",
            "HOME": "/pufferpanel",
            "WINEARCH": "win64",
            "WINEDEBUG": "-all",
            "WINEDLLOVERRIDES": "mscoree=d;mshtml=d",
            "WINEPREFIX": "/pufferpanel/.wine"
        },
        "stdin": {
            "type": "stdin"
        },
        "autostart": false,
        "autorecover": true,
        "autorestart": false
    },
    "environment": {
        "type": "docker",
        "networkName": "host",
        "portBindings": [],
        "image": "halalixy/enshrouded-server:latest"
    },
    "supportedEnvironments": [
        {
            "type": "docker",
            "image": "halalixy/enshrouded-server:latest",
            "networkName": "host",
            "portBindings": []
        }
    ],
    "requirements": {},
    "stats": {
        "type": ""
    },
    "query": {
        "type": ""
    },
    "keepAlive": {
        "frequency": "",
        "command": ""
    },
    "name": "enshrouded"
}

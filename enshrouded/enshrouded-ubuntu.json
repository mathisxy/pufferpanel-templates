{
  "name": "enshrouded-ubuntu",
  "type": "enshrouded",
  "display": "Enshrouded Server",
  "data": {
    "serverName": {
      "type": "string",
      "value": "Enshrouded Server",
      "display": "Server Name",
      "desc": "Shown in the in-game server list.",
      "required": true,
      "userEdit": true
    },
    "queryPort": {
      "type": "integer",
      "value": 15637,
      "display": "Query Port",
      "desc": "The only port the server uses (UDP). Must be unique per server, e.g. 15637, 15638, ...",
      "required": true,
      "userEdit": true
    },
    "slotCount": {
      "type": "integer",
      "value": 16,
      "display": "Player Slots",
      "desc": "Maximum number of players (1-16).",
      "required": true,
      "userEdit": true
    },
    "gameSettingsPreset": {
      "type": "option",
      "value": "Default",
      "display": "Difficulty Preset",
      "desc": "With Custom, edit gameSettings in enshrouded_server.json. It is left untouched on start.",
      "required": true,
      "userEdit": true,
      "options": [
        { "value": "Default", "display": "Default" },
        { "value": "Relaxed", "display": "Relaxed" },
        { "value": "Hard", "display": "Hard" },
        { "value": "Survival", "display": "Survival" },
        { "value": "Custom", "display": "Custom" }
      ]
    },
    "enableVoiceChat": {
      "type": "boolean",
      "value": false,
      "display": "Enable Voice Chat",
      "required": false,
      "userEdit": true
    },
    "enableTextChat": {
      "type": "boolean",
      "value": false,
      "display": "Enable Text Chat",
      "required": false,
      "userEdit": true
    },
    "adminPassword": {
      "type": "string",
      "value": "",
      "display": "Admin Group Password",
      "desc": "Kick/ban, open inventories, edit world and base.",
      "required": true,
      "userEdit": true
    },
    "friendPassword": {
      "type": "string",
      "value": "",
      "display": "Friend Group Password",
      "desc": "Open inventories, edit world and base. No kick/ban.",
      "required": true,
      "userEdit": true
    },
    "guestPassword": {
      "type": "string",
      "value": "",
      "display": "Guest Group Password",
      "desc": "Join only, no changes.",
      "required": true,
      "userEdit": true
    },
    "visitorPassword": {
      "type": "string",
      "value": "",
      "display": "Visitor Group Password",
      "desc": "Join only, no changes.",
      "required": true,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "steamcmd +@sSteamCmdForcePlatformType windows +force_install_dir /pufferpanel +login anonymous +app_update 2278520 validate +quit"
      ]
    },
    {
      "type": "command",
      "commands": [
        "sh -c \"WINEPREFIX=/pufferpanel/.wine WINEARCH=win64 WINEDLLOVERRIDES='mscoree=d;mshtml=d' HOME=/pufferpanel wine64 wineboot --init\""
      ]
    }
  ],
  "run": {
    "command": "xvfb-run -a wine64 enshrouded_server.exe",
    "stopCode": 15,
    "stdin": {
      "type": "stdin"
    },
    "environmentVars": {
      "HOME": "/pufferpanel",
      "WINEPREFIX": "/pufferpanel/.wine",
      "WINEARCH": "win64",
      "WINEDEBUG": "-all",
      "WINEDLLOVERRIDES": "mscoree=d;mshtml=d",
      "ENSH_NAME": "${serverName}",
      "ENSH_QUERY_PORT": "${queryPort}",
      "ENSH_SLOT_COUNT": "${slotCount}",
      "ENSH_PRESET": "${gameSettingsPreset}",
      "ENSH_VOICE_CHAT": "${enableVoiceChat}",
      "ENSH_TEXT_CHAT": "${enableTextChat}",
      "ENSH_PW_ADMIN": "${adminPassword}",
      "ENSH_PW_FRIEND": "${friendPassword}",
      "ENSH_PW_GUEST": "${guestPassword}",
      "ENSH_PW_VISITOR": "${visitorPassword}"
    },
    "pre": [
      {
        "type": "command",
        "commands": [
          "steamcmd +@sSteamCmdForcePlatformType windows +force_install_dir /pufferpanel +login anonymous +app_update 2278520 +quit"
        ]
      },
      {
        "type": "writefile",
        "target": "update_config.jq",
        "text": "def req(k): env[k] // error(\"missing environment variable \" + k);\ndef upd(k; v): if has(k) then .[k] = v else . end;\ndef pw(gname; v): if has(\"userGroups\") then .userGroups |= map(if .name == gname and has(\"password\") then .password = v else . end) else . end;\nupd(\"name\"; req(\"ENSH_NAME\"))\n| upd(\"queryPort\"; req(\"ENSH_QUERY_PORT\") | tonumber)\n| upd(\"slotCount\"; req(\"ENSH_SLOT_COUNT\") | tonumber)\n| upd(\"enableVoiceChat\"; req(\"ENSH_VOICE_CHAT\") == \"true\")\n| upd(\"enableTextChat\"; req(\"ENSH_TEXT_CHAT\") == \"true\")\n| upd(\"gameSettingsPreset\"; req(\"ENSH_PRESET\"))\n| pw(\"Admin\"; req(\"ENSH_PW_ADMIN\"))\n| pw(\"Friend\"; req(\"ENSH_PW_FRIEND\"))\n| pw(\"Guest\"; req(\"ENSH_PW_GUEST\"))\n| pw(\"Visitor\"; req(\"ENSH_PW_VISITOR\"))\n| if ([.userGroups[]? | .password // empty] | length) == ([.userGroups[]? | .password // empty] | unique | length) then . else error(\"group passwords must be unique\") end\n"
      },
      {
        "type": "command",
        "commands": [
          "sh -c \"if [ -f /pufferpanel/enshrouded_server.json ]; then jq -f /pufferpanel/update_config.jq /pufferpanel/enshrouded_server.json > /pufferpanel/enshrouded_server.json.new && mv /pufferpanel/enshrouded_server.json.new /pufferpanel/enshrouded_server.json; fi\""
        ]
      }
    ],
    "autostart": false,
    "autorecover": true,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "halalixy/enshrouded-server:latest",
    "networkMode": "host",
    "portBindings": []
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "halalixy/enshrouded-server:latest",
      "networkMode": "host",
      "portBindings": []
    }
  ],
  "groups": [
    {
      "display": "Server",
      "description": "Written on start into existing keys of enshrouded_server.json. The game creates that file on its first start, so these apply from the second start.",
      "variables": [
        "serverName",
        "queryPort",
        "slotCount",
        "gameSettingsPreset",
        "enableVoiceChat",
        "enableTextChat"
      ],
      "order": 1
    },
    {
      "display": "Group Passwords",
      "description": "Only applied to groups of the same name that already exist in the config. All passwords must differ.",
      "variables": [
        "adminPassword",
        "friendPassword",
        "guestPassword",
        "visitorPassword"
      ],
      "order": 2
    }
  ]
}
